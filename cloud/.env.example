# Copy to .env and edit. docker compose reads .env automatically.

# The owner page is owner.<BASE_DOMAIN>; each venue is <venue>.<BASE_DOMAIN>.
# Use "localhost" to try it on your computer (Chrome opens *.localhost by itself).
BASE_DOMAIN=karaoke.example.com

OWNER_PASSWORD=change-me

# Shown to venues when their trial ends or a payment is overdue.
OWNER_CONTACT=you@example.com

# Absolute path on this server for owner.json and every venue's songs and data.
# Back it up.
HOST_DATA_DIR=/opt/karaoke-cloud/data

# How guests reach the venues. Behind a TLS proxy keep https and no port;
# locally use http and the port below.
PUBLIC_SCHEME=https
PUBLIC_PORT=

# Where Traefik listens. Behind Nginx Proxy Manager use 172.17.0.1:8088.
HTTP_BIND=8088

TZ=Asia/Manila
