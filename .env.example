# Copy to .env and edit. docker compose reads .env automatically.

# Address guests use to reach the app; shown in the QR code on the splash screen.
# Use this machine's LAN IP (e.g. http://192.168.1.50:5555) and the port below.
KNL_URL=http://192.168.1.50:5555

# Host port the web interface is published on.
KNL_PORT=5555

# Timezone for play history timestamps (a "TZ identifier" from
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=Asia/Manila

# Where songs and app data live on the host.
KNL_SONGS_DIR=./songs
KNL_DATA_DIR=./data
